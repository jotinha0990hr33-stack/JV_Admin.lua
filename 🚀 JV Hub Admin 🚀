    -- LISTENER DE CHAT (ÚNICO SYNC AGORA)
    local function ProcessarMensagemRecebida(msg, senderName)
        if not msg or msg:sub(1,1) ~= "/" then return end

        -- /aviso <mensagem>
        local avisoMsg = msg:match("^/aviso%s+(.+)$")
        if avisoMsg then
            CriarAnuncioBonito(senderName or "JV HUB ADM", avisoMsg)
            return
        end

        -- /ch <target> <mensagem>
        local chAlvo, chMsg = msg:match("^/ch%s+(%S+)%s+(.+)$")
        if chAlvo and chMsg then
            if string.lower(chAlvo) == string.lower(LocalPlayer.Name) then
                pcall(function()
                    local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                        or TextChatService.TextChannels:GetChildren()[1]
                    if channel then channel:SendAsync(chMsg) end
                end)
            end
            return
        end

        -- /verifique
        if msg:lower():match("^/verifique") then
            FuncoesADMChat.verifique()
            return
        end

        -- /<comando> <alvo>
        local cmdNome, alvo = msg:match("^/(%S+)%s*(%S*)")
        if not cmdNome then return end
        cmdNome = string.lower(cmdNome)
        if alvo == "" or not alvo then alvo = "todos" end

        if FuncoesADMChat[cmdNome] then
            FuncoesADMChat[cmdNome](alvo)
            return
        end
        local idNum = IDsPorNome[cmdNome]
        if idNum then
            ExecutarComandoComFuncaoReal(idNum, alvo)
        end
    end

    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            TextChatService.MessageReceived:Connect(function(m)
                if m.TextSource then
                    local p = Players:GetPlayerByUserId(m.TextSource.UserId)
                    if p then ProcessarMensagemRecebida(m.Text, p.Name) end
                end
            end)
        end
    end)
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            p.Chatted:Connect(function(msg) ProcessarMensagemRecebida(msg, p.Name) end)
        end
        Players.PlayerAdded:Connect(function(p)
            p.Chatted:Connect(function(msg) ProcessarMensagemRecebida(msg, p.Name) end)
        end)
    end)

